{
  "astryx": {
    "command": "$NODE",
    "args": [
      "channel/server.mjs"
    ],
    "env": {
      "ASTRYX_AGENT": "$AGENT",
      "ASTRYX_HOME": "$ORGH"
    },
    "author": "seed",
    "who": "every",
    "about": "the wire: send, read threads and steps, subscribe, triggers, self_edit",
    "list": "--list-tools"
  },
  "tools": {
    "command": "venv/bin/python",
    "args": [
      "mcp/tools/server.py"
    ],
    "author": "forge",
    "who": "every"
  },
  "hands": {
    "command": "venv/bin/python",
    "args": [
      "mcp/hands/server.py"
    ],
    "env": {
      "ASTRYX_AGENT": "$AGENT",
      "XDG_RUNTIME_DIR": "/run/user/$UID",
      "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/$UID/bus"
    },
    "author": "seed",
    "who": "every"
  },
  "influence": {
    "command": "venv/bin/python",
    "args": [
      "mcp/influence/server.py"
    ],
    "author": "memory",
    "env": {
      "ASTRYX_AGENT": "$AGENT"
    },
    "who": "every"
  },
  "channels": {
    "command": "venv/bin/python",
    "args": [
      "mcp/channels/server.py"
    ],
    "author": "unknown",
    "env": {
      "ASTRYX_AGENT": "$AGENT"
    },
    "who": "every"
  },
  "phone": {
    "command": "venv/bin/python",
    "args": [
      "mcp/phone/server.py"
    ],
    "env": {
      "ASTRYX_AGENT": "$AGENT"
    },
    "author": "seed",
    "who": "opt-in",
    "optin": "ANDROID_ENABLED"
  },
  "chat-sql": {
    "command": "/bin/bash",
    "args": [
      "mcp/chat-sql/run.sh"
    ],
    "author": "seed",
    "who": "grant"
  },
  "ocr": {
    "command": "venv/bin/python",
    "args": [
      "mcp/ocr/server.py"
    ],
    "author": "seed",
    "who": "grant"
  },
  "compose": {
    "command": "venv/bin/python",
    "args": [
      "mcp/compose/server.py"
    ],
    "author": "unknown",
    "who": "grant"
  },
  "imagegen": {
    "command": "venv/bin/python",
    "args": [
      "mcp/imagegen/server.py"
    ],
    "author": "unknown",
    "who": "grant"
  },
  "growbot": {
    "command": "venv/bin/python",
    "args": [
      "mcp/growbot/server.py"
    ],
    "author": "unknown",
    "who": "grant"
  },
  "org": {
    "command": "venv/bin/python",
    "args": [
      "mcp/org/server.py"
    ],
    "author": "seed",
    "who": "grant"
  },
  "memory": {
    "command": "venv/bin/python",
    "args": [
      "mcp/memory/server.py"
    ],
    "author": "forge",
    "who": "grant"
  },
  "jobs": {
    "command": "venv/bin/python",
    "args": [
      "mcp/jobs/server.py"
    ],
    "author": "canopus",
    "who": "grant"
  },
  "docpdf": {
    "command": "venv/bin/python",
    "args": [
      "mcp/docpdf/server.py"
    ],
    "author": "canopus",
    "who": "grant"
  },
  "browser": {
    "command": "$NPX",
    "args": [
      "-y",
      "@playwright/mcp@latest",
      "--headless",
      "--executable-path",
      "/usr/bin/chromium",
      "--user-data-dir",
      "$HOME_D/.browser-profile"
    ],
    "env": {
      "XDG_RUNTIME_DIR": "/run/user/$UID",
      "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/$UID/bus"
    },
    "author": "seed",
    "who": "grant"
  },
  "etl": {
    "command": "venv/bin/python",
    "args": [
      "mcp/etl/server.py"
    ],
    "env": {
      "ASTRYX_AGENT": "$AGENT"
    },
    "author": "seed",
    "who": "grant",
    "about": "the ETL box as typed tools: Task Scheduler jobs, Prefect deployments/runs/logs, failures, box health; acts for the etl seats"
  }
}
