  {"name": "ports: an integral float (18477.0: node reads the integer 18477, so python must too)", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": {"astryx-whatsapp": 18477.0}}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "orgs:2"},
  {"name": "ports: 0", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": {"astryx-whatsapp": 0}}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "refused"},
  {"name": "ports: 65536", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": {"astryx-whatsapp": 65536}}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "refused"},
  {"name": "ports: an array, not an object", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": [18477]}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "refused"},
  {"name": "ports: a number (node's Object.entries(5) is empty)", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": 5}, "fxb": {"home": "{T}/b", "db": "fxorg_b"}}}, "expect": "refused"},
  {"name": "ports: true", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": true}, "fxb": {"home": "{T}/b", "db": "fxorg_b"}}}, "expect": "refused"},
  {"name": "ports: an empty string", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": ""}, "fxb": {"home": "{T}/b", "db": "fxorg_b"}}}, "expect": "refused"},
  {"name": "ports: null", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": null}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "refused"},
  {"name": "ports: a stem named like an object property", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": {"constructor": 18477}}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "refused"}
 ]
