  {"name": "ports: a port-free stem given a port", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": {"astryx-pulse": 18001}}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "refused"},
  {"name": "ports: an unknown stem", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": {"astryx-whatsap": 18477}}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "refused"},
