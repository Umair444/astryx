  {"name": "ports: empty object", "registry": {"orgs": {"fxa": {"home": "{T}/a", "db": "fxorg_a", "ports": {}}, "fxb": {"home": "{T}/b", "db": "fxorg_b", "ports": {}}}}, "expect": "orgs:2"},
